{
  "item": [
    {
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.variables.set(\"scenario_id\",pm.iterationData.get(\"scenario_id\") || \"mixed_rates\");",
              "pm.variables.set(\"expected_percent\",pm.iterationData.get(\"expected_percent\") || 8);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const r=pm.response.json();",
              "const expected=Number(pm.iterationData.get(\"expected_percent\") || 8);",
              "const matches=r.results.filter(x=>{const f=x.keys?.commission_info?.fareCalculation?.ADT||[];return f.some(a=>a.departure===\"RDU\"&&a.arrival===\"MUC\"&&a.bookingClass===\"D\"&&a.commissions?.GTT?.upfront?.subRule===25020)&&f.some(a=>a.departure===\"MAD\"&&a.arrival===\"FRA\"&&a.bookingClass===\"Z\"&&a.commissions?.GTT?.upfront?.subRule===25021);});",
              "if(!matches.length){pm.test.skip(\"WARN: matching fare/rule inventory unavailable\",()=>{});}else{pm.test(\"Both Average fares receive expected rate\",()=>matches.forEach(x=>{const f=x.keys.commission_info.fareCalculation.ADT;for(const id of [25020,25021]){const a=f.find(a=>a.commissions?.GTT?.upfront?.subRule===id);pm.expect(a.commissions.GTT.upfront.contract).to.eql(\"Average\");pm.expect(a.commissions.GTT.upfront.percent).to.eql([expected]);}}));}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "name": "Average commission Search",
      "request": {
        "auth": {
          "basic": [
            {
              "key": "username",
              "value": "{{auth_login}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{auth_password}}",
              "type": "string"
            }
          ],
          "type": "basic"
        },
        "method": "GET",
        "url": "https://api.search.dev.travel-dev.com/v1/search?extra=false&cabin=C&fl.2.o=MAD&fl.2.d=RDU&fl.2.dt=2026-12-03&adt=1&debug=true&fare=PUB&cid=TOJ101&gds=S&pcc=6NVG&fl.0.dt=2026-11-20&fl.1.o=AMS&fl.1.d=LHR&fl.1.dt=2026-11-30&fl.0.o=RDU&fl.0.d=MUC&val_cr=LH&basic=false"
      }
    }
  ],
  "variable": [
    {
      "key": "auth_login",
      "value": ""
    },
    {
      "key": "auth_password",
      "value": ""
    }
  ],
  "info": {
    "name": "SS-6389 CMS average Search",
    "description": "Exact user Search; no provider tracks. Credentials blank. expected_percent comes from CSV. Commissionless fields remain distinct from explicit zero. Both rate scenarios were executed directly; CSV expected_percent must match the active user-configured rules.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  }
}
